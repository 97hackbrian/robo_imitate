def call_ros2_service(activate_controllers, deactivate_controllers):
    service_name = '/controller_manager/switch_controller'
    service_type = 'controller_manager_msgs/srv/SwitchController'
    strictness = '2'
    activate_asap = 'true'

    command = f'ros2 service call {service_name} {service_type} "{{activate_controllers: [\"{activate_controllers}\"], deactivate_controllers: [\"{deactivate_controllers}\"], strictness: {strictness}, activate_asap: {activate_asap}}}"'
    try:
        result = subprocess.run(command, shell=True,
                                check=True, capture_output=True, text=True)
        match = re.search(r'response:\n(.*)', result.stdout, re.DOTALL)
        print(f"{activate_controllers}:", match.group(1).strip())
    except subprocess.CalledProcessError as e:
        print(f"Error calling ROS 2 service: {e}")



class OperationState(Enum):
    IDLE = 0
    INFERENCE = 1
    GO_CLOSE = 2
    CLOSE_GRIPPER = 3
    PICK_UP = 4
    OPEN_GRIPPER = 5
    END = 6


def check_pose_stamped_values(pose_stamped_msg):
    position = pose_stamped_msg.pose.position
    orientation = pose_stamped_msg.pose.orientation
    is_position_zero = position.x == 0.0 and position.y == 0.0 and position.z == 0.0
    
    is_orientation_zero_except_w = orientation.x == 0.0 and orientation.y == 0.0 and orientation.z == 0.0 and orientation.w == 1.0
    
    return is_orientation_zero_except_w


class PickScrewdriver(Node):

    def __init__(self, sim, random_spawn=False):
        super().__init__('pick_screwdriver')
        self.random_spawn = random_spawn
        self.get_logger().info("PickScrewdriver node started")

        self.image_subscriber = self.create_subscription(
            Image,
            '/rgb',
            self.image_callback,
            1)
        self.bridge = CvBridge()
        
        self.timer_freq = 0.05
        self.timer = self.create_timer(self.timer_freq, self.publish_pose)

        self.publisher_speed_limiter = self.create_publisher(
            PoseStamped, '/target_frame_raw', 1)

        self.isaac_gripper_publisher = self.create_publisher(
            Float64MultiArray, '/position_controller/commands', 1)

        self.current_pose_subscriber = self.create_subscription(
            PoseStamped,
            '/current_pose',
            self.current_pose_callback,
            1)
        self.current_pose_subscriber

        self.imitation = Imitation()
        
        self.current_pose_relativ = PoseStamped()
        self.current_pose = PoseStamped()
        self.step = 0
        
        self.image  = None
        self.action = None

        # 60 steps for sim, 90 for real env
        self.max_episode_steps = 1500 if sim else 1600

        self.sim = sim

        self.observation_pose = None
        self.observation_current_pose = PoseStamped()
        if self.sim:
            # on init open griper and move screwdriver on random position
            self.gripper_state = Float64MultiArray()
            self.gripper_state.data = [0.0]
            self.isaac_gripper_publisher.publish(self.gripper_state)

            self.random_move_screwdriver = self.create_publisher(Twist, '/respawn', 1)
            twist_msg = Twist()
            
            if self.random_spawn:
                self.target_spawn_x = random.uniform(0.22, 0.40)
                self.target_spawn_y = random.uniform(-0.12, 0.18)
            else:
                self.target_spawn_x = 0.35
                self.target_spawn_y = 0.10
                
            twist_msg.linear.x = self.target_spawn_x
            twist_msg.linear.y = self.target_spawn_y
            twist_msg.linear.z = 0.012
            self.random_move_screwdriver.publish(twist_msg)
        else:
            self.lite6_gripper_publisher = self.create_publisher(Int32, '/gripper_switcher', 1)
            gripper_state_msg = Int32()
            gripper_state_msg.data = 1
            self.lite6_gripper_publisher.publish(gripper_state_msg)

            time.sleep(1)
            msg = Int32()
            msg.data = 2
            self.lite6_gripper_publisher.publish(msg)

        self.timer = time.time()

        self.publisher_joint_init = self.create_publisher(
            JointTrajectory, '/joint_trajectory_controller/joint_trajectory', 1)
        self.joint_state = JointTrajectory()
        self.joint_names = ['joint1', 'joint2',
                            'joint3', 'joint4', 'joint5', 'joint6']

        point = JointTrajectoryPoint()
        point.positions = [0.00148, 0.06095, 1.164, -0.00033, 1.122, -0.00093]
        point.time_from_start.sec = 3
        point.time_from_start.nanosec = 0

        self.joint_state.points = [point]
        self.joint_state.joint_names = self.joint_names
           
        # move arm to init pose
        call_ros2_service('joint_trajectory_controller',
                              'cartesian_motion_controller')
        self.joint_state.header.stamp = self.get_clock().now().to_msg()
        self.publisher_joint_init.publish(self.joint_state)
        time.sleep(3)
        call_ros2_service('cartesian_motion_controller', 'joint_trajectory_controller')
        
        self.tfBuffer = tf2_ros.Buffer()
        self.tfListener = tf2_ros.TransformListener(self.tfBuffer, self)

        self.state = OperationState.IDLE
        self.observation_current_pose = PoseStamped()
        self.start_pose = None


        self.plotting_observations = []
        self.plotting_actions = []

        # Require the observed x/y position to be stationary for a short window
        # before honoring the z<0.09 close trigger, so the policy has actually
        # stopped correcting laterally before the gripper commits to closing.
        self.recent_xy_positions = deque(maxlen=6)
        self.xy_settle_tolerance = 0.015

        # Measures whether imitation.step() keeps up with the control-loop period,
        # so a real-time compute bottleneck can be confirmed/ruled out with data
        # instead of guessed at.
        self.inference_latencies = []

        # Metrics setup
        now_str = datetime.now().strftime("%Y_%m_%d_%H_%M_%S")
        self.metrics_folder = f"imitation/outputs/results/{now_str}"
        os.makedirs(self.metrics_folder, exist_ok=True)
        self.global_csv_path = "imitation/outputs/results/global_metrics.csv"
        
        self.final_gripper_x = None
        self.final_gripper_y = None
    
    def get_transform(self, target_frame, source_frame):
        try:
            transform = self.tfBuffer.lookup_transform(
                target_frame, source_frame, rclpy.time.Time())
            return transform
        except (tf2_ros.LookupException, tf2_ros.ConnectivityException, tf2_ros.ExtrapolationException) as e:
            self.get_logger().error(f"Failed to get transform: {e}")
            return None
    
    def current_pose_callback(self, msg):
        self.observation_current_pose = msg
        x_pos = msg.pose.position.x
        y_pos = msg.pose.position.y
        z_pos = msg.pose.position.z

        x_ori = msg.pose.orientation.x
        y_ori = msg.pose.orientation.y
        z_ori = msg.pose.orientation.z
        w_ori = msg.pose.orientation.w

        quat = [w_ori, x_ori, y_ori, z_ori]
        euler_angle = t3d.euler.quat2euler(quat)

        self.observation_pose = [x_pos, y_pos, z_pos, euler_angle[0], euler_angle[1], euler_angle[2]]
        self.observation_current_pose = msg

    def image_callback(self, msg):
        cv_image = self.bridge.imgmsg_to_cv2(msg, desired_encoding='rgb8')
        cv_image = cv2.resize(cv_image, (256, 256))
        self.image = cv_image
          
    def publish_pose(self):

        if self.observation_pose is None:
            return
        
        if self.image is None:
            return

        base_gripper_tf = self.get_transform('link_base', 'gripper_base_link')
        if base_gripper_tf is None:
            return
        
        self.get_logger().info(f'========================={self.state}=========================')

        self.current_pose.header.stamp = self.get_clock().now().to_msg()
        self.current_pose.header.frame_id = 'link_base'

    
        if self.state == OperationState.IDLE:
            if self.sim:
                twist_msg = Twist()
                twist_msg.linear.x = self.target_spawn_x
                twist_msg.linear.y = self.target_spawn_y
                twist_msg.linear.z = 0.012
                self.random_move_screwdriver.publish(twist_msg)
            
            self.start_pose = self.observation_current_pose
            if self.start_pose is not None and self.start_pose.pose.position.x != 0.0:
                self.state = OperationState.INFERENCE
                self.timer = time.time()

        elif self.state == OperationState.INFERENCE:

            _infer_start = time.time()
            self.action = self.imitation.step(self.image, self.observation_pose)
            infer_latency = time.time() - _infer_start
            self.inference_latencies.append(infer_latency)
            if infer_latency > self.timer_freq:
                self.get_logger().warn(
                    f'imitation.step() took {infer_latency*1000:.1f} ms, over the '
                    f'{self.timer_freq*1000:.0f} ms ({1.0/self.timer_freq:.0f} Hz) control '
                    f'period — the arm may be executing stale actions, including during descent.')

            if self.action is None:
                return
            
            self.get_logger().info(f"Step {self.step}, Action: {self.action}")

            self.current_pose_relativ.header.stamp = self.get_clock().now().to_msg()
            self.current_pose_relativ.header.frame_id = 'gripper_link_base'
            
            # Multiplicador de velocidad para compensar los deltas pequeños de 20Hz
            speed_multiplier = 40.0
            
            self.current_pose_relativ.pose.position.x = float(self.action[0]) * speed_multiplier
            self.current_pose_relativ.pose.position.y = float(self.action[1]) * speed_multiplier
            self.current_pose_relativ.pose.position.z = float(self.action[2]) * speed_multiplier

            quat = t3d.euler.euler2quat(self.action[3] * speed_multiplier, 
                                        self.action[4] * speed_multiplier, 
                                        self.action[5] * speed_multiplier)

            self.current_pose_relativ.pose.orientation.x = float(quat[1])
            self.current_pose_relativ.pose.orientation.y = float(quat[2])
            self.current_pose_relativ.pose.orientation.z = float(quat[3])
            self.current_pose_relativ.pose.orientation.w = float(quat[0])


            current_pose_target = ros2numpy(self.current_pose_relativ.pose)
            target_rotation = ros2numpy(self.observation_current_pose.pose) @ current_pose_target
            target_rotation = target_rotation[:3, :3]

            target_transform = ros2numpy(self.observation_current_pose.pose) @ current_pose_target

            self.plotting_actions.append(target_transform[:3, 3])
            self.plotting_observations.append(self.observation_pose[:3])

            target_transform[:3, :3] = target_rotation

            pose = numpy2ros(target_transform, Pose)
            self.start_pose.pose = pose
            self.current_pose.pose = pose

            self.recent_xy_positions.append((
                self.observation_current_pose.pose.position.x,
                self.observation_current_pose.pose.position.y,
            ))
            xy_settled = False
            if len(self.recent_xy_positions) == self.recent_xy_positions.maxlen:
                xs = [p[0] for p in self.recent_xy_positions]
                ys = [p[1] for p in self.recent_xy_positions]
                xy_settled = (max(xs) - min(xs) < self.xy_settle_tolerance) and \
                             (max(ys) - min(ys) < self.xy_settle_tolerance)

            if self.observation_current_pose.pose.position.z < 0.135 and xy_settled:
                self.final_gripper_x = self.observation_current_pose.pose.position.x
                self.final_gripper_y = self.observation_current_pose.pose.position.y
                self.state = OperationState.OPEN_GRIPPER
                self.timer = time.time()
                self.get_logger().info('___________________________________ END ___________________________________')



            self.publisher_speed_limiter.publish(self.current_pose)

            self.step += 1

            if self.step > self.max_episode_steps:
                plot_action_trajectory(self.sim, self.plotting_observations, self.plotting_actions)
                self.state = OperationState.OPEN_GRIPPER
                self.timer = time.time()

        elif self.state == OperationState.OPEN_GRIPPER:
            # open later because make noise
            if not self.sim:
                msg = Int32()
                msg.data = 1
                self.lite6_gripper_publisher.publish(msg)

            if time.time() - self.timer > 0.4:
                self.state = OperationState.GO_CLOSE
                self.timer = time.time()

        elif self.state == OperationState.GO_CLOSE:
                self.observation_current_pose.pose.position.z = 0.09
                self.publisher_speed_limiter.publish(self.observation_current_pose)
                if time.time() - self.timer > 4.5:
                    self.state = OperationState.CLOSE_GRIPPER
                    self.timer  =time.time()
        
        elif self.state == OperationState.CLOSE_GRIPPER:
            if self.sim:
                self.gripper_state.data = [-0.01]
                self.isaac_gripper_publisher.publish(self.gripper_state)
            else:
                msg = Int32()
                msg.data = 0
                self.lite6_gripper_publisher.publish(msg)

            if time.time() -  self.timer > 1.5:
                self.state = OperationState.PICK_UP
                self.timer = time.time()
        elif self.state == OperationState.PICK_UP:
                self.observation_current_pose.pose.position.z = 0.29
                self.publisher_speed_limiter.publish(self.observation_current_pose)
                if time.time() - self.timer > 1.5:
                    self.state = OperationState.END
                    self.timer = time.time()

        elif self.state == OperationState.END:

            if time.time() - self.timer > 3.0:
                if not self.sim:
                    # shutdown gripper
                    msg = Int32()
                    msg.data = 2
                    self.lite6_gripper_publisher.publish(msg)

                self.get_logger().info(f"Finished publishing. Saving metrics and shutting down node...")
                self.save_metrics()
                rclpy.shutdown()
                exit(0)

    def save_metrics(self):
        # 1. Target Reaching Error
        error = -1.0
        if self.target_spawn_x is not None and self.final_gripper_x is not None:
            error = math.sqrt((self.final_gripper_x - self.target_spawn_x)**2 + (self.final_gripper_y - self.target_spawn_y)**2)
        
        # 2. Smoothness / Jerk (Variance of deltas)
        actions = np.array(self.plotting_actions)
        smoothness = -1.0
        if len(actions) > 1:
            deltas = np.diff(actions, axis=0)
            smoothness = float(np.var(deltas))

        # 3. Inference latency vs. control-loop budget (real-time bottleneck check)
        latencies = np.array(self.inference_latencies)
        mean_latency_ms = float(latencies.mean() * 1000) if len(latencies) else -1.0
        max_latency_ms = float(latencies.max() * 1000) if len(latencies) else -1.0
        budget_ms = self.timer_freq * 1000
        over_budget_pct = float((latencies > self.timer_freq).mean() * 100) if len(latencies) else -1.0
        if len(latencies):
            verdict = "BOTTLENECK" if over_budget_pct > 5 else "ok"
            self.get_logger().info(
                f'Inference latency: mean={mean_latency_ms:.1f}ms max={max_latency_ms:.1f}ms '
                f'budget={budget_ms:.0f}ms ({over_budget_pct:.1f}% of steps over budget) -> {verdict}')

        # 4. Create DataFrame
        df = pd.DataFrame([{
            "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            "target_spawn_x": self.target_spawn_x,
            "target_spawn_y": self.target_spawn_y,
            "final_gripper_x": self.final_gripper_x,
            "final_gripper_y": self.final_gripper_y,
            "target_reaching_error": error,
            "steps_to_converge": self.step,
            "trajectory_variance": smoothness,
            "inference_latency_mean_ms": mean_latency_ms,
            "inference_latency_max_ms": max_latency_ms,
            "inference_latency_budget_ms": budget_ms,
            "inference_steps_over_budget_pct": over_budget_pct,
        }])

        # Save to local run folder
        local_csv = os.path.join(self.metrics_folder, "run_metrics.csv")
        df.to_csv(local_csv, index=False)

        # Save/Append to global CSV
        if not os.path.exists(self.global_csv_path):
            df.to_csv(self.global_csv_path, index=False)
        else:
            df.to_csv(self.global_csv_path, mode='a', header=False, index=False)

        # Plot 2D Trajectory (Top-Down view)
        if len(self.plotting_observations) > 0:
            obs = np.array(self.plotting_observations)
            plt.figure(figsize=(10, 8))
            plt.plot(obs[:, 0], obs[:, 1], label="Gripper Trajectory", color="blue", linewidth=2)
            plt.scatter(obs[0, 0], obs[0, 1], color="green", s=100, label="Start", zorder=5)
            
            if self.final_gripper_x is not None:
                plt.scatter(self.final_gripper_x, self.final_gripper_y, color="blue", marker="X", s=100, label="Final Gripper Pose", zorder=5)
            
            if self.target_spawn_x is not None:
                plt.scatter(self.target_spawn_x, self.target_spawn_y, color="red", marker="*", s=200, label="Screwdriver Target", zorder=5)

            plt.title("Top-Down View (X-Y Plane)")
            plt.xlabel("X axis")
            plt.ylabel("Y axis")
            plt.legend()
            plt.grid(True)
            plot_path = os.path.join(self.metrics_folder, "trajectory_2d.png")
            plt.savefig(plot_path, bbox_inches='tight')
            plt.close()

            # Plot Z trajectory
            plt.figure(figsize=(10, 4))
            plt.plot(range(len(obs)), obs[:, 2], color="purple", linewidth=2)
            plt.title("Z-axis (Height) over Steps")
            plt.xlabel("Step")
            plt.ylabel("Z Height")
            plt.grid(True)
            plot_path_z = os.path.join(self.metrics_folder, "trajectory_z.png")
            plt.savefig(plot_path_z, bbox_inches='tight')
            plt.close()

       
        if check_pose_stamped_values(self.current_pose_relativ):
            return

def main(args=None):

    import argparse
    parser = argparse.ArgumentParser(description='PickScrewdriver')
    parser.add_argument('--sim', action='store_true', help='Use simulation')
    parser.add_argument('--random', action='store_true', help='Use random object spawning in sim')
    parsed_args = parser.parse_args()

    rclpy.init(args=args)
    cmd_vel_publisher = PickScrewdriver(parsed_args.sim, parsed_args.random)
    rclpy.spin(cmd_vel_publisher)
    cmd_vel_publisher.destroy_node()
    rclpy.shutdown()

if __name__ == '__main__':
    main()
