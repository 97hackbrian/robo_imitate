def call_ros2_service(activate_controllers, deactivate_controllers):
    service_name = '/controller_manager/switch_controller'
    service_type = 'controller_manager_msgs/srv/SwitchController'
    strictness = '2'
    activate_asap = 'true'

    command = f'ros2 service call {service_name} {service_type} "{{activate_controllers: [\"{activate_controllers}\"], deactivate_controllers: [\"{deactivate_controllers}\"], strictness: {strictness}, activate_asap: {activate_asap}}}"'
    try:
        result = subprocess.run(command, shell=True,
                                check=True, capture_output=True, text=True)
        match = re.search(r'response:\n(.*)', result.stdout, re.DOTALL)
        print(f"{activate_controllers}:", match.group(1).strip())
    except subprocess.CalledProcessError as e:
        print(f"Error calling ROS 2 service: {e}")



class OperationState(Enum):
    IDLE = 0
    INFERENCE = 1
    GO_CLOSE = 2
    CLOSE_GRIPPER = 3
    PICK_UP = 4
    OPEN_GRIPPER = 5
    END = 6


def check_pose_stamped_values(pose_stamped_msg):
    position = pose_stamped_msg.pose.position
    orientation = pose_stamped_msg.pose.orientation
    is_position_zero = position.x == 0.0 and position.y == 0.0 and position.z == 0.0
    
    is_orientation_zero_except_w = orientation.x == 0.0 and orientation.y == 0.0 and orientation.z == 0.0 and orientation.w == 1.0
    
    return is_orientation_zero_except_w


class PickScrewdriver(Node):

    def __init__(self, sim, random_spawn=False):
        super().__init__('pick_screwdriver')
        self.random_spawn = random_spawn
        self.get_logger().info("PickScrewdriver node started")

        self.image_subscriber = self.create_subscription(
            Image,
            '/rgb',
            self.image_callback,
            1)
        self.bridge = CvBridge()
        
        self.timer_freq = TIMER_FREQ
        self.timer = self.create_timer(self.timer_freq, self.publish_pose)

        self.publisher_speed_limiter = self.create_publisher(
            PoseStamped, '/target_frame_raw', 1)

        self.isaac_gripper_publisher = self.create_publisher(
            Float64MultiArray, '/position_controller/commands', 1)

        self.current_pose_subscriber = self.create_subscription(
            PoseStamped,
            '/current_pose',
            self.current_pose_callback,
            1)
        self.current_pose_subscriber

        self.imitation = Imitation()
        
        self.current_pose_relativ = PoseStamped()
        self.current_pose = PoseStamped()
        self.step = 0
        
        self.image  = None
        self.action = None

        # Episode step limits
        self.max_episode_steps = MAX_EPISODE_STEPS_SIM if sim else MAX_EPISODE_STEPS_REAL

        self.sim = sim

        self.observation_pose = None
        self.observation_current_pose = PoseStamped()
        if self.sim:
            # on init open griper and move screwdriver on random position
            self.gripper_state = Float64MultiArray()
            self.gripper_state.data = [0.0]
            self.isaac_gripper_publisher.publish(self.gripper_state)

            self.random_move_screwdriver = self.create_publisher(Twist, '/respawn', 1)
            twist_msg = Twist()
            
            if self.random_spawn:
                self.target_spawn_x = random.uniform(SPAWN_X_MIN, SPAWN_X_MAX)
                self.target_spawn_y = random.uniform(SPAWN_Y_MIN, SPAWN_Y_MAX)
            else:
                self.target_spawn_x = 0.35
                self.target_spawn_y = 0.10
                
            twist_msg.linear.x = self.target_spawn_x
            twist_msg.linear.y = self.target_spawn_y
            twist_msg.linear.z = 0.012
            self.random_move_screwdriver.publish(twist_msg)
        else:
            self.lite6_gripper_publisher = self.create_publisher(Int32, '/gripper_switcher', 1)
            gripper_state_msg = Int32()
            gripper_state_msg.data = 1
            self.lite6_gripper_publisher.publish(gripper_state_msg)

            time.sleep(1)
            msg = Int32()
            msg.data = 2
            self.lite6_gripper_publisher.publish(msg)

        self.timer = time.time()

        self.publisher_joint_init = self.create_publisher(
            JointTrajectory, '/joint_trajectory_controller/joint_trajectory', 1)
        self.joint_state = JointTrajectory()
        self.joint_names = ['joint1', 'joint2',
                            'joint3', 'joint4', 'joint5', 'joint6']

        point = JointTrajectoryPoint()
        point.positions = [0.00148, 0.06095, 1.164, -0.00033, 1.122, -0.00093]
        point.time_from_start.sec = 3
        point.time_from_start.nanosec = 0

        self.joint_state.points = [point]
        self.joint_state.joint_names = self.joint_names
           
        # move arm to init pose
        call_ros2_service('joint_trajectory_controller',
                              'cartesian_motion_controller')
        self.joint_state.header.stamp = self.get_clock().now().to_msg()
        self.publisher_joint_init.publish(self.joint_state)
        time.sleep(3)
        call_ros2_service('cartesian_motion_controller', 'joint_trajectory_controller')
        
        self.tfBuffer = tf2_ros.Buffer()
        self.tfListener = tf2_ros.TransformListener(self.tfBuffer, self)

        self.state = OperationState.IDLE
        self.observation_current_pose = PoseStamped()
        self.start_pose = None


        self.plotting_observations = []
        self.plotting_actions = []

        # Wait for the model to "settle" in X and Y before dropping down
        self.recent_xy_positions = deque(maxlen=XY_SETTLE_FRAMES)
        self.xy_settle_tolerance = XY_SETTLE_TOLERANCE

        # Measures whether imitation.step() keeps up with the control-loop period,
        # so a real-time compute bottleneck can be confirmed/ruled out with data
        # instead of guessed at.
        self.inference_latencies = []

        # Metrics setup
        now_str = datetime.now().strftime("%Y_%m_%d_%H_%M_%S")
        self.metrics_folder = f"imitation/outputs/results/{now_str}"
        os.makedirs(self.metrics_folder, exist_ok=True)
        self.global_csv_path = "imitation/outputs/results/global_metrics.csv"
        
        self.final_gripper_x = None
        self.final_gripper_y = None

        # Trigger height for the grasp sequence
        self.trigger_z = TRIGGER_Z

        # Real-time dashboard publisher (~2 Hz via throttle counter)
        self.dashboard_pub = self.create_publisher(
            CompressedImage, '/inference_dashboard/compressed', 1)
        self.dashboard_tick = 0
        self.DASHBOARD_EVERY_N = DASHBOARD_EVERY_N  # publish every N control ticks
    
    def get_transform(self, target_frame, source_frame):
        try:
            transform = self.tfBuffer.lookup_transform(
                target_frame, source_frame, rclpy.time.Time())
            return transform
        except (tf2_ros.LookupException, tf2_ros.ConnectivityException, tf2_ros.ExtrapolationException) as e:
            self.get_logger().error(f"Failed to get transform: {e}")
            return None
    
    def current_pose_callback(self, msg):
        self.observation_current_pose = msg
        x_pos = msg.pose.position.x
        y_pos = msg.pose.position.y
        z_pos = msg.pose.position.z

        x_ori = msg.pose.orientation.x
        y_ori = msg.pose.orientation.y
        z_ori = msg.pose.orientation.z
        w_ori = msg.pose.orientation.w

        quat = [w_ori, x_ori, y_ori, z_ori]
        euler_angle = t3d.euler.quat2euler(quat)

        self.observation_pose = [x_pos, y_pos, z_pos, euler_angle[0], euler_angle[1], euler_angle[2]]
        self.observation_current_pose = msg

    def image_callback(self, msg):
        cv_image = self.bridge.imgmsg_to_cv2(msg, desired_encoding='rgb8')
        cv_image = cv2.resize(cv_image, (256, 256))
        self.image = cv_image
          
    def publish_pose(self):

        if self.observation_pose is None:
            return
        
        if self.image is None:
            return

        base_gripper_tf = self.get_transform('link_base', 'gripper_base_link')
        if base_gripper_tf is None:
            return
        
        self.get_logger().info(f'========================={self.state}=========================')

        self.current_pose.header.stamp = self.get_clock().now().to_msg()
        self.current_pose.header.frame_id = 'link_base'

    
        if self.state == OperationState.IDLE:
            if self.sim:
                twist_msg = Twist()
                twist_msg.linear.x = self.target_spawn_x
                twist_msg.linear.y = self.target_spawn_y
                twist_msg.linear.z = 0.012
                self.random_move_screwdriver.publish(twist_msg)
            
            self.start_pose = self.observation_current_pose
            if self.start_pose is not None and self.start_pose.pose.position.x != 0.0:
                self.state = OperationState.INFERENCE
                self.timer = time.time()

        elif self.state == OperationState.INFERENCE:
            
            # Capture the ACTUAL object position from TF for accurate plotting
            # We wait until step 10 (0.5s into inference) to ensure Isaac Sim has spawned the object and updated TF
            if self.step == 10 and self.sim:
                obj_tf = self.get_transform('link_base', 'pick_target')
                if obj_tf is not None:
                    self.target_spawn_x = obj_tf.transform.translation.x
                    self.target_spawn_y = obj_tf.transform.translation.y
                    self.get_logger().info(
                        f'Actual object TF position (Step 10): ({self.target_spawn_x:.3f}, {self.target_spawn_y:.3f})')

            _infer_start = time.time()
            self.action = self.imitation.step(self.image, self.observation_pose)
            infer_latency = time.time() - _infer_start
            self.inference_latencies.append(infer_latency)
            if infer_latency > self.timer_freq:
                self.get_logger().warn(
                    f'imitation.step() took {infer_latency*1000:.1f} ms, over the '
                    f'{self.timer_freq*1000:.0f} ms ({1.0/self.timer_freq:.0f} Hz) control '
                    f'period — the arm may be executing stale actions, including during descent.')

            if self.action is None:
                return
            
            self.get_logger().info(f"Step {self.step}, Action: {self.action}")

            self.current_pose_relativ.header.stamp = self.get_clock().now().to_msg()
            self.current_pose_relativ.header.frame_id = 'gripper_link_base'
            
            # Speed multiplier to compensate for small deltas at 20Hz
            self.speed_multiplier = SPEED_MULTIPLIER
            
            self.current_pose_relativ.pose.position.x = float(self.action[0]) * self.speed_multiplier
            self.current_pose_relativ.pose.position.y = float(self.action[1]) * self.speed_multiplier
            self.current_pose_relativ.pose.position.z = float(self.action[2]) * self.speed_multiplier

            quat = t3d.euler.euler2quat(self.action[3] * self.speed_multiplier, 
                                        self.action[4] * self.speed_multiplier, 
                                        self.action[5] * self.speed_multiplier)

            self.current_pose_relativ.pose.orientation.x = float(quat[1])
            self.current_pose_relativ.pose.orientation.y = float(quat[2])
            self.current_pose_relativ.pose.orientation.z = float(quat[3])
            self.current_pose_relativ.pose.orientation.w = float(quat[0])


            current_pose_target = ros2numpy(self.current_pose_relativ.pose)
            target_rotation = ros2numpy(self.observation_current_pose.pose) @ current_pose_target
            target_rotation = target_rotation[:3, :3]

            target_transform = ros2numpy(self.observation_current_pose.pose) @ current_pose_target

            self.plotting_actions.append(target_transform[:3, 3])
            self.plotting_observations.append(self.observation_pose[:3])

            target_transform[:3, :3] = target_rotation

            pose = numpy2ros(target_transform, Pose)
            self.start_pose.pose = pose
            self.current_pose.pose = pose

            self.recent_xy_positions.append((
                self.observation_current_pose.pose.position.x,
                self.observation_current_pose.pose.position.y,
            ))
            xy_settled = False
            if len(self.recent_xy_positions) == self.recent_xy_positions.maxlen:
                xs = [p[0] for p in self.recent_xy_positions]
                ys = [p[1] for p in self.recent_xy_positions]
                xy_settled = (max(xs) - min(xs) < self.xy_settle_tolerance) and \
                             (max(ys) - min(ys) < self.xy_settle_tolerance)

            if self.observation_current_pose.pose.position.z < self.trigger_z and xy_settled:
                self.final_gripper_x = self.observation_current_pose.pose.position.x
                self.final_gripper_y = self.observation_current_pose.pose.position.y
                self.state = OperationState.OPEN_GRIPPER
                self.timer = time.time()
                self.get_logger().info('___________________________________ END ___________________________________')



            self.publisher_speed_limiter.publish(self.current_pose)

            self.step += 1

            # Real-time dashboard (throttled)
            self.dashboard_tick += 1
            if self.dashboard_tick >= self.DASHBOARD_EVERY_N:
                self.dashboard_tick = 0
                self.publish_dashboard()

            if self.step > self.max_episode_steps:
                plot_action_trajectory(self.sim, self.plotting_observations, self.plotting_actions)
                self.state = OperationState.OPEN_GRIPPER
                self.timer = time.time()

        elif self.state == OperationState.OPEN_GRIPPER:
            # open later because make noise
            if not self.sim:
                msg = Int32()
                msg.data = 1
                self.lite6_gripper_publisher.publish(msg)

            if time.time() - self.timer > 0.4:
                self.state = OperationState.GO_CLOSE
                self.timer = time.time()

        elif self.state == OperationState.GO_CLOSE:
                self.observation_current_pose.pose.position.z = FINAL_GRASP_Z ## final grasp height
                self.publisher_speed_limiter.publish(self.observation_current_pose)
                if time.time() - self.timer > 5.0:
                    self.state = OperationState.CLOSE_GRIPPER
                    self.timer  =time.time()
        
        elif self.state == OperationState.CLOSE_GRIPPER:
            if self.sim:
                self.gripper_state.data = [-0.01]
                self.isaac_gripper_publisher.publish(self.gripper_state)
            else:
                msg = Int32()
                msg.data = 0
                self.lite6_gripper_publisher.publish(msg)

            if time.time() -  self.timer > 1.5:
                self.state = OperationState.PICK_UP
                self.timer = time.time()
        elif self.state == OperationState.PICK_UP:
                self.observation_current_pose.pose.position.z = 0.29
                self.publisher_speed_limiter.publish(self.observation_current_pose)
                if time.time() - self.timer > 1.5:
                    self.state = OperationState.END
                    self.timer = time.time()

        elif self.state == OperationState.END:

            if time.time() - self.timer > 3.0:
                if not self.sim:
                    # shutdown gripper
                    msg = Int32()
                    msg.data = 2
                    self.lite6_gripper_publisher.publish(msg)

                self.get_logger().info(f"Finished publishing. Saving metrics and shutting down node...")
                self.save_metrics()
                rclpy.shutdown()
                exit(0)

    def save_metrics(self):
        # 1. Target Reaching Error
        error = -1.0
        if self.target_spawn_x is not None and self.final_gripper_x is not None:
            error = math.sqrt((self.final_gripper_x - self.target_spawn_x)**2 +
                              (self.final_gripper_y - self.target_spawn_y)**2)

        # 2. Smoothness / Jerk (Variance of deltas)
        actions_arr = np.array(self.plotting_actions) if len(self.plotting_actions) else np.empty((0, 3))
        obs_arr = np.array(self.plotting_observations) if len(self.plotting_observations) else np.empty((0, 3))
        smoothness = -1.0
        if len(actions_arr) > 1:
            deltas = np.diff(actions_arr, axis=0)
            smoothness = float(np.var(deltas))

        # 3. Inference latency vs. control-loop budget
        latencies = np.array(self.inference_latencies)
        mean_latency_ms = float(latencies.mean() * 1000) if len(latencies) else -1.0
        max_latency_ms = float(latencies.max() * 1000) if len(latencies) else -1.0
        budget_ms = self.timer_freq * 1000
        over_budget_pct = float((latencies > self.timer_freq).mean() * 100) if len(latencies) else -1.0
        if len(latencies):
            verdict = "BOTTLENECK" if over_budget_pct > 5 else "ok"
            self.get_logger().info(
                f'Inference latency: mean={mean_latency_ms:.1f}ms max={max_latency_ms:.1f}ms '
                f'budget={budget_ms:.0f}ms ({over_budget_pct:.1f}% over budget) -> {verdict}')

        # 4. Save CSV
        df = pd.DataFrame([{
            "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            "target_spawn_x": self.target_spawn_x,
            "target_spawn_y": self.target_spawn_y,
            "final_gripper_x": self.final_gripper_x,
            "final_gripper_y": self.final_gripper_y,
            "target_reaching_error": error,
            "steps_to_converge": self.step,
            "trajectory_variance": smoothness,
            "inference_latency_mean_ms": mean_latency_ms,
            "inference_latency_max_ms": max_latency_ms,
            "inference_latency_budget_ms": budget_ms,
            "inference_steps_over_budget_pct": over_budget_pct,
        }])
        local_csv = os.path.join(self.metrics_folder, "run_metrics.csv")
        df.to_csv(local_csv, index=False)
        if not os.path.exists(self.global_csv_path):
            df.to_csv(self.global_csv_path, index=False)
        else:
            df.to_csv(self.global_csv_path, mode='a', header=False, index=False)

        # -----------------------------------------------------------
        # 5. Generate 2x2 Summary Figure
        # -----------------------------------------------------------
        fig, axes = plt.subplots(2, 2, figsize=(16, 12))
        fig.suptitle('Inference Run Summary', fontsize=16, fontweight='bold')

        # --- Panel (0,0): 2D Trajectory (top-down X-Y) ---
        ax = axes[0, 0]
        if len(obs_arr) > 0:
            ax.plot(obs_arr[:, 0], obs_arr[:, 1],
                    label='Observed Gripper Path', color='dodgerblue', linewidth=2)
            ax.scatter(obs_arr[0, 0], obs_arr[0, 1],
                       color='limegreen', s=120, zorder=5, label='Start', edgecolors='k')
        if len(actions_arr) > 0:
            ax.plot(actions_arr[:, 0], actions_arr[:, 1],
                    label='Commanded Target Path', color='orange', linewidth=1.5, linestyle='--')
        if self.final_gripper_x is not None:
            ax.scatter(self.final_gripper_x, self.final_gripper_y,
                       color='blue', marker='X', s=120, zorder=5,
                       label='Final Gripper Pose', edgecolors='k')
        if self.target_spawn_x is not None:
            ax.scatter(self.target_spawn_x, self.target_spawn_y,
                       color='red', marker='*', s=250, zorder=5,
                       label='Object Target')
            # Dashed error line
            if self.final_gripper_x is not None:
                ax.plot([self.final_gripper_x, self.target_spawn_x],
                        [self.final_gripper_y, self.target_spawn_y],
                        'r--', linewidth=1, alpha=0.6,
                        label=f'Error: {error:.4f} m')
        ax.set_title('Top-Down Trajectory (X-Y Plane)')
        ax.set_xlabel('X (m)')
        ax.set_ylabel('Y (m)')
        ax.set_xlim(PLOT_X_LIMS)
        ax.set_ylim(PLOT_Y_LIMS)
        ax.legend(fontsize=8, loc='best')
        ax.grid(True, alpha=0.3)
        ax.set_aspect('equal', adjustable='box')

        # --- Panel (0,1): Z-Height over Steps ---
        ax = axes[0, 1]
        if len(obs_arr) > 0:
            steps_range = range(len(obs_arr))
            ax.plot(steps_range, obs_arr[:, 2],
                    color='purple', linewidth=2, label='Observed Z')
        if len(actions_arr) > 0:
            ax.plot(range(len(actions_arr)), actions_arr[:, 2],
                    color='orange', linewidth=1.5, linestyle='--', label='Commanded Z')
        ax.axhline(y=self.trigger_z, color='red', linestyle=':',
                   linewidth=1.5, label=f'Trigger Height ({self.trigger_z} m)')
        ax.set_title('Z-Height (Descent Profile) over Steps')
        ax.set_xlabel('Step')
        ax.set_ylabel('Z Height (m)')
        ax.legend(fontsize=8, loc='best')
        ax.grid(True, alpha=0.3)

        # --- Panel (1,0): Inference Latency Histogram ---
        ax = axes[1, 0]
        if len(latencies) > 0:
            latencies_ms = latencies * 1000
            ax.hist(latencies_ms, bins=30, color='steelblue', edgecolor='white', alpha=0.8)
            ax.axvline(x=budget_ms, color='red', linestyle='--',
                       linewidth=2, label=f'Budget ({budget_ms:.0f} ms)')
            ax.axvline(x=mean_latency_ms, color='green', linestyle='-',
                       linewidth=1.5, label=f'Mean ({mean_latency_ms:.1f} ms)')
        ax.set_title('Inference Latency Distribution')
        ax.set_xlabel('Latency (ms)')
        ax.set_ylabel('Count')
        ax.legend(fontsize=8, loc='best')
        ax.grid(True, alpha=0.3)

        # --- Panel (1,1): Stats Summary Text ---
        ax = axes[1, 1]
        ax.axis('off')
        stats_lines = [
            f'Total Steps: {self.step}',
            f'Target Position: ({self.target_spawn_x:.3f}, {self.target_spawn_y:.3f})' if self.target_spawn_x else 'Target Position: N/A',
            f'Final Gripper: ({self.final_gripper_x:.3f}, {self.final_gripper_y:.3f})' if self.final_gripper_x else 'Final Gripper: N/A',
            f'Target Reaching Error: {error:.4f} m' if error >= 0 else 'Target Reaching Error: N/A',
            '',
            f'Trajectory Variance: {smoothness:.6f}' if smoothness >= 0 else 'Trajectory Variance: N/A',
            '',
            f'Latency Mean: {mean_latency_ms:.1f} ms',
            f'Latency Max: {max_latency_ms:.1f} ms',
            f'Control Budget: {budget_ms:.0f} ms ({1.0/self.timer_freq:.0f} Hz)',
            f'Steps Over Budget: {over_budget_pct:.1f}%',
            '',
            f'n_action_steps: {self.imitation.policy.config.n_action_steps}',
            f'num_inference_steps: {self.imitation.policy.diffusion.num_inference_steps}',
            f'speed_multiplier: {self.speed_multiplier}',
        ]
        stats_text = '\n'.join(stats_lines)
        ax.text(0.05, 0.95, stats_text, transform=ax.transAxes,
                fontsize=12, verticalalignment='top', fontfamily='monospace',
                bbox=dict(boxstyle='round,pad=0.5', facecolor='lightyellow', alpha=0.8))
        ax.set_title('Run Statistics')

        plt.tight_layout(rect=[0, 0, 1, 0.96])
        summary_path = os.path.join(self.metrics_folder, 'summary.png')
        plt.savefig(summary_path, bbox_inches='tight', dpi=150)
        plt.close(fig)
        self.get_logger().info(f'Summary saved to {summary_path}')

    # ------------------------------------------------------------------
    # Real-time dashboard published as CompressedImage (~2 Hz)
    # ------------------------------------------------------------------
    def publish_dashboard(self):
        """Render a 2x2 live dashboard and publish as CompressedImage."""
        try:
            obs_arr = np.array(self.plotting_observations) if len(self.plotting_observations) else np.empty((0, 3))
            act_arr = np.array(self.plotting_actions) if len(self.plotting_actions) else np.empty((0, 3))

            fig = plt.figure(figsize=(10, 10), dpi=100)
            gs = fig.add_gridspec(3, 2, height_ratios=[1, 1, 0.3])
            fig.suptitle(f'Live Inference Dashboard  —  Step {self.step}', fontsize=14, fontweight='bold')

            # --- (0,0) Live 2D Trajectory ---
            ax1 = fig.add_subplot(gs[0, 0])
            if len(obs_arr) > 0:
                ax1.plot(obs_arr[:, 0], obs_arr[:, 1], color='dodgerblue', linewidth=1.5, label='Gripper')
                ax1.scatter(obs_arr[-1, 0], obs_arr[-1, 1], color='dodgerblue', s=60, zorder=5, edgecolors='k')
                ax1.scatter(obs_arr[0, 0], obs_arr[0, 1], color='limegreen', s=80, zorder=5, label='Start')
            if self.target_spawn_x is not None:
                ax1.scatter(self.target_spawn_x, self.target_spawn_y,
                           color='red', marker='*', s=200, zorder=5, label='Target')
                # Draw success zone circle
                circle = plt.Circle((self.target_spawn_x, self.target_spawn_y), SUCCESS_ZONE_RADIUS, color='green', fill=False, linestyle='--', linewidth=1.5, label='Success Zone')
                ax1.add_patch(circle)
            ax1.set_title('X-Y Trajectory', fontsize=10)
            ax1.set_xlabel('X (m)', fontsize=8)
            ax1.set_ylabel('Y (m)', fontsize=8)
            ax1.set_xlim(PLOT_X_LIMS)
            ax1.set_ylim(PLOT_Y_LIMS)
            ax1.legend(fontsize=7, loc='best')
            ax1.grid(True, alpha=0.3)
            ax1.set_aspect('equal', adjustable='box')

            # --- (0,1) Live Z-Height ---
            ax2 = fig.add_subplot(gs[0, 1])
            if len(obs_arr) > 0:
                ax2.plot(range(len(obs_arr)), obs_arr[:, 2], color='purple', linewidth=1.5)
            ax2.axhline(y=self.trigger_z, color='red', linestyle=':', linewidth=1.5, label=f'Trigger ({self.trigger_z}m)')
            ax2.set_title('Z-Height over Steps', fontsize=10)
            ax2.set_xlabel('Step', fontsize=8)
            ax2.set_ylabel('Z (m)', fontsize=8)
            ax2.legend(fontsize=7, loc='best')
            ax2.grid(True, alpha=0.3)

            # --- (1,0) Rolling Latency Bar ---
            ax3 = fig.add_subplot(gs[1, 0])
            n_show = min(40, len(self.inference_latencies))
            if n_show > 0:
                recent = np.array(self.inference_latencies[-n_show:]) * 1000
                colors = ['tomato' if v > self.timer_freq * 1000 else 'steelblue' for v in recent]
                ax3.bar(range(n_show), recent, color=colors, edgecolor='white', linewidth=0.3)
                ax3.axhline(y=self.timer_freq * 1000, color='red', linestyle='--', linewidth=1.5, label=f'Budget ({self.timer_freq*1000:.0f}ms)')
            ax3.set_title('Recent Inference Latency', fontsize=10)
            ax3.set_xlabel('Recent Steps', fontsize=8)
            ax3.set_ylabel('ms', fontsize=8)
            ax3.legend(fontsize=7, loc='best')
            ax3.grid(True, alpha=0.3)

            # --- (1,1) Distance Error over Steps ---
            ax4 = fig.add_subplot(gs[1, 1])
            if self.target_spawn_x is not None and len(obs_arr) > 0:
                distances = np.sqrt((obs_arr[:, 0] - self.target_spawn_x)**2 + (obs_arr[:, 1] - self.target_spawn_y)**2)
                ax4.plot(range(len(distances)), distances, color='crimson', linewidth=1.5, label='X-Y Distance')
                ax4.axhline(y=SUCCESS_ZONE_RADIUS, color='green', linestyle='--', linewidth=1.5, label=f'Success Zone ({SUCCESS_ZONE_RADIUS}m)')
            ax4.set_title('Distance to Target over Steps', fontsize=10)
            ax4.set_xlabel('Step', fontsize=8)
            ax4.set_ylabel('Distance (m)', fontsize=8)
            ax4.legend(fontsize=7, loc='best')
            ax4.grid(True, alpha=0.3)

            # --- (2, 0:2) Live Stats (Spans 2 columns) ---
            ax5 = fig.add_subplot(gs[2, :])
            ax5.axis('off')
            cur_error = '—'
            if self.target_spawn_x is not None and len(obs_arr) > 0:
                dx = obs_arr[-1, 0] - self.target_spawn_x
                dy = obs_arr[-1, 1] - self.target_spawn_y
                cur_error = f'{math.sqrt(dx*dx + dy*dy):.4f} m'
            mean_lat = f'{np.mean(self.inference_latencies)*1000:.1f}' if self.inference_latencies else '—'
            cur_z = f'{obs_arr[-1, 2]:.3f}' if len(obs_arr) > 0 else '—'
            lines = [
                f'State:  {self.state.name}',
                f'Step:   {self.step} / {self.max_episode_steps}',
                f'Z now:  {cur_z} m',
                f'Dist to target: {cur_error}',
                f'Mean latency:   {mean_lat} ms',
                f'Speed mult:     {self.speed_multiplier}x',
            ]
            ax5.text(0.5, 0.2, '\n'.join(lines), transform=ax5.transAxes,
                    fontsize=13, horizontalalignment='center', verticalalignment='center', fontfamily='monospace',
                    bbox=dict(boxstyle='round,pad=0.5', facecolor='lightyellow', alpha=0.8))

            plt.tight_layout(rect=[0, 0, 1, 0.95])

            # Render to JPEG bytes
            buf = io.BytesIO()
            fig.savefig(buf, format='jpg', bbox_inches='tight', dpi=100)
            plt.close(fig)
            buf.seek(0)

            msg = CompressedImage()
            msg.header.stamp = self.get_clock().now().to_msg()
            msg.format = 'jpeg'
            msg.data = buf.getvalue()
            self.dashboard_pub.publish(msg)
        except Exception as e:
            self.get_logger().warn(f'Dashboard render error: {e}')

def main(args=None):

    import argparse
    parser = argparse.ArgumentParser(description='PickScrewdriver')
    parser.add_argument('--sim', action='store_true', help='Use simulation')
    parser.add_argument('--random', action='store_true', help='Use random object spawning in sim')
    parsed_args = parser.parse_args()

    rclpy.init(args=args)
    cmd_vel_publisher = PickScrewdriver(parsed_args.sim, parsed_args.random)
    rclpy.spin(cmd_vel_publisher)
    cmd_vel_publisher.destroy_node()
    rclpy.shutdown()

if __name__ == '__main__':
    main()
