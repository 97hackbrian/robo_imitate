#!/usr/bin/env python3

import rclpy
from rclpy.node import Node
from geometry_msgs.msg import PoseStamped, Twist, Pose, TransformStamped
from std_msgs.msg import Float64MultiArray
from trajectory_msgs.msg import JointTrajectory, JointTrajectoryPoint
from controller_manager_msgs.srv import SwitchController
from sensor_msgs.msg import Image
from cv_bridge import CvBridge, CvBridgeError
from ros2_numpy_tf import ros2numpy
import ros2_numpy as rnp
import transforms3d as t3d
from std_msgs.msg import Int32

import tf2_ros
import time
from enum import Enum
import subprocess
import re
import numpy as np
import random
import math
import cv2
import os
import argparse
from datetime import datetime
from copy import deepcopy


class EnvStates(Enum):
    IDLE = 0
    CLOSE_GRIPPER = 1
    OPEN_GRIPPER = 2
    RESET = 3
    UP = 4
    DOWN = 5
    MOVE = 6
    GO_CLOSE = 7


class GripperStatus(Enum):
    OPEN = 0
    CLOSE = 1


def are_transforms_close(a, b=None, linear_tol=0.03, angular_tol=0.03, check_angular=True):
    if b is None:
        b = np.eye(4)
    c = np.linalg.inv(a) @ b
    xyz = c[:3, 3]
    if np.any(np.abs(xyz) > linear_tol):
        return False
    if check_angular:
        rpy = t3d.euler.mat2euler(c[:3, :3])
        if np.any(np.abs(np.array(rpy)) > angular_tol):
            return False
    return True


def call_ros2_service(activate_controllers, deactivate_controllers):
    service_name = '/controller_manager/switch_controller'
    service_type = 'controller_manager_msgs/srv/SwitchController'
    strictness = '2'
    activate_asap = 'true'

    command = f'ros2 service call {service_name} {service_type} "{{activate_controllers: [\"{activate_controllers}\"], deactivate_controllers: [\"{deactivate_controllers}\"], strictness: {strictness}, activate_asap: {activate_asap}}}"'
    try:
        result = subprocess.run(command, shell=True,
                                check=True, capture_output=True, text=True)
        match = re.search(r'response:\n(.*)', result.stdout, re.DOTALL)
        print(f"{activate_controllers}:", match.group(1).strip())
    except subprocess.CalledProcessError as e:
        print(f"Error calling ROS 2 service: {e}")


def is_identity_transformation(matrix):
    identity_matrix = np.eye(4)
    return np.allclose(matrix, identity_matrix)


class ControlObjectPicking(Node):
    def __init__(self, data_dir='DATA'):
        super().__init__('control_object_picking_subscriber')
        self.DATA_DIR = data_dir
        self.get_logger().info(f"Saving teleoperation data to: {self.DATA_DIR}")

        # Image and Pose Subscribers
        self.image_subscriber = self.create_subscription(
            Image,
            '/rgb',
            self.image_callback,
            1)
        self.cv_bridge = CvBridge()
        self.image = None

        self.current_pose_subscriber = self.create_subscription(
            PoseStamped,
            '/current_pose',
            self.current_pose_callback,
            1)

        # Recording State Variables
        self.observation_file = None
        self.action_filename = None
        self.images_folder = None
        self.images_counter = 0
        self.observations = []

        # Target Pose publishers and clients
        self.timer = self.create_timer(0.1, self.publish_pose)

        self.publisher_speed_limiter = self.create_publisher(
            PoseStamped, '/target_frame_raw', 1)

        self.publisher_gripper_state = self.create_publisher(
            Float64MultiArray, '/position_controller/commands', 1)

        self.publisher_respawn = self.create_publisher(Twist, '/respawn', 1)

        self.publisher_joint_init = self.create_publisher(
            JointTrajectory, '/joint_trajectory_controller/joint_trajectory', 1)

        self.switch_service = self.create_client(
            SwitchController, '/controller_manager/switch_controller')
        while not self.switch_service.wait_for_service(timeout_sec=1.0):
            self.get_logger().info('Switch service not available, waiting again...')

        self.tfBuffer = tf2_ros.Buffer()
        self.tfListener = tf2_ros.TransformListener(self.tfBuffer, self)
        self.target_pose = PoseStamped()
        self.current_relative_pose = TransformStamped()

        self.joint_state = JointTrajectory()
        self.joint_names = ['joint1', 'joint2',
                            'joint3', 'joint4', 'joint5', 'joint6']

        point = JointTrajectoryPoint()
        point.positions = [0.00148, 0.06095, 1.164, -0.00033, 1.122, -0.00093]
        point.time_from_start.sec = 3
        point.time_from_start.nanosec = 0

        self.joint_state.points = [point]
        self.joint_state.joint_names = self.joint_names

        # move screwdriver to random position with wide dispersion
        self._publish_random_respawn()

        self.start_time = time.time()
        self.is_object_picked = False
        self.next_episode_trigger = False
        self.is_arm_init = False
        self.is_trajectory_controler_active = False
        self.new_episode = True
        self.skip_saving = True

        self.state = EnvStates.IDLE
        self.gripper_status = GripperStatus.OPEN
        self.previous_state = self.state

        self.end_episode_cnt = 0
        self.previous_pose = PoseStamped()
        self.current_pose = PoseStamped()

        self.relative_move = PoseStamped()
        self.initial_orientation = None

    def image_callback(self, msg):
        try:
            cv2_img = self.cv_bridge.imgmsg_to_cv2(msg, "rgb8")
            cv2_img = cv2.resize(cv2_img, (96, 96))
            self.image = cv2_img
        except CvBridgeError as e:
            self.get_logger().error(f"CvBridge Error: {e}")

    def current_pose_callback(self, msg):
        self.current_pose = msg

    def get_action_from_observations(self, observations):
        actions = []

        for idx in range(len(observations)):
            observation = ros2numpy(observations[idx])
            
            if idx < len(observations) - 1:
                next_observation = ros2numpy(observations[idx + 1])
            else:
                next_observation = observation # Last frame has zero relative movement (identity)

            action = np.linalg.inv(observation) @ next_observation

            translation = action[:3, 3]

            rotation = t3d.euler.mat2euler(action[:3, :3])

            pose = np.concatenate((translation, rotation))     

            action_str = '[{}]'.format(', '.join(map(str, pose))) + '\n'

            actions.append(action_str)

        return actions

    def save_episode(self, dir_path):
        date = datetime.now()
        episode_name = date.strftime("%Y_%m_%d_%H_%M_%S")
        self.images_folder = dir_path + '/' + episode_name
        observation_folder = dir_path + '/observations'
        action_folder = dir_path + '/actions'

        os.makedirs(dir_path, exist_ok=True)
        os.makedirs(self.images_folder, exist_ok=True)
        os.makedirs(observation_folder, exist_ok=True)
        os.makedirs(action_folder, exist_ok=True)

        observation_file_name = observation_folder + '/' + episode_name + '.txt'
        action_file_name = action_folder + '/' + episode_name + '.txt'

        self.observation_file = open(observation_file_name, "a")
        self.action_filename = open(action_file_name, "a")
        self.get_logger().info(f'Episode {episode_name} saving started...')

    def save_current_frame(self):
        img = self.image
        if self.images_folder is None or img is None:
            return False
        
        x_pos = self.current_pose.pose.position.x
        y_pos = self.current_pose.pose.position.y
        z_pos = self.current_pose.pose.position.z

        x_ori = self.current_pose.pose.orientation.x
        y_ori = self.current_pose.pose.orientation.y
        z_ori = self.current_pose.pose.orientation.z
        w_ori = self.current_pose.pose.orientation.w

        quat = [w_ori, x_ori, y_ori, z_ori]
        euler_angles_o = t3d.euler.quat2euler(quat)

        observation = (
            f"[{x_pos}, {y_pos}, {z_pos}, {euler_angles_o[0]}, {euler_angles_o[1]}, {euler_angles_o[2]}]\n")

        image_name = self.images_folder + '/' + str(self.images_counter) + '.jpg'
        cv2.imwrite(image_name, cv2.cvtColor(img, cv2.COLOR_RGB2BGR))
        self.observation_file.write(observation)

        self.images_counter += 1
        return True

    def switch_motion_controller(self, activate_controllers, deactivate_controllers):
        request = SwitchController.Request()
        request.activate_controllers = [activate_controllers]
        request.deactivate_controllers = [deactivate_controllers]
        request.strictness = 2
        request.activate_asap = True

        self.switch_service.call(request)

    def get_transform(self, target_frame, source_frame):
        try:
            transform = self.tfBuffer.lookup_transform(
                target_frame, source_frame, rclpy.time.Time())
            return transform
        except (tf2_ros.LookupException, tf2_ros.ConnectivityException, tf2_ros.ExtrapolationException) as e:
            self.get_logger().error(f"Failed to get transform: {e}")
            return None

    def publish_pose(self):
        # TF transforms lookup
        gripper_target_tf = self.get_transform('gripper_base_link', 'pick_target')
        base_gripper_tf = self.get_transform('link_base', 'gripper_base_link')

        if gripper_target_tf is None or base_gripper_tf is None:
            return

        if self.previous_state != self.state:
            self.previous_state = self.state

        # Save current observation if recording is enabled
        if not self.skip_saving:
            if self.save_current_frame():
                self.observations.append(deepcopy(self.current_pose))

        self.target_pose.header.stamp = self.get_clock().now().to_msg()
        self.target_pose.header.frame_id = 'link_base'

        gripper_target = rnp.numpify(gripper_target_tf.transform)
        base_gripper = rnp.numpify(base_gripper_tf.transform)

        target_transform = base_gripper @ gripper_target

        # Overwrite orientation to be PERFECTLY vertical (gripper pointing straight down)
        # Assuming link_base Z is up, we point gripper Z down (pitch/roll adjustment)
        import transforms3d as t3d
        if self.initial_orientation is not None:
            euler = t3d.euler.mat2euler(self.initial_orientation, axes='sxyz')
            # For lite6, to point down, pitch should be around pi (3.14159)
            perfect_vertical_matrix = t3d.euler.euler2mat(3.14159265, 0.0, euler[2], axes='sxyz')
            target_transform[:3, :3] = perfect_vertical_matrix

        previous_pose = rnp.numpify(self.previous_pose.pose)
        current_pose = rnp.numpify(self.current_pose.pose)

        self.previous_pose = self.current_pose

        previous_current_pose = np.linalg.inv(current_pose) @ previous_pose

        self.relative_move.pose = rnp.msgify(Pose, previous_current_pose)

        pose = rnp.msgify(Pose, target_transform)

        if not self.is_arm_init:
            call_ros2_service('joint_trajectory_controller',
                              'cartesian_motion_controller')
            self.joint_state.header.stamp = self.get_clock().now().to_msg()
            self.publisher_joint_init.publish(self.joint_state)
            self.is_arm_init = True
            self.get_logger().info(f'Arm inited...')
            self.start_time = time.time()

        if self.state == EnvStates.IDLE:

            if time.time() - self.start_time > 3.0:
                call_ros2_service('cartesian_motion_controller',
                                  'joint_trajectory_controller')
                self.is_trajectory_controler_active = False
                self.get_logger().info('Start...')
                self.initial_orientation = base_gripper[:3, :3].copy()
                print(f"INITIAL ORIENTATION CAPTURED AFTER SETTLE:\n{self.initial_orientation}")
                self.state = EnvStates.MOVE

                if self.new_episode:
                    self.new_episode = False
                    self.skip_saving = False
                    self.end_episode_cnt = 0

                    self.save_episode(self.DATA_DIR)
                    self.images_counter = 0
                    self.observations = []

        elif self.state == EnvStates.MOVE:
            self.target_pose.pose = pose
            if are_transforms_close(gripper_target, check_angular=False):
                # Save final frame
                if not self.skip_saving:
                    if self.save_current_frame():
                        self.observations.append(deepcopy(self.current_pose))
                self.skip_saving = True

                if self.end_episode_cnt > 10:
                    self.state = EnvStates.GO_CLOSE
                    self.target_pose.pose.position.z = 0.09
                    self.start_time = time.time()

                    # End episode and save actions
                    if len(self.observations) > 0:
                        actions = self.get_action_from_observations(self.observations)
                        self.action_filename.writelines(actions)
                        self.get_logger().info(f"Saved {len(actions)} actions for this episode.")
                        
                        # Close files
                        if self.observation_file:
                            self.observation_file.close()
                            self.observation_file = None
                        if self.action_filename:
                            self.action_filename.close()
                            self.action_filename = None
                    self.observations = []
                    self.images_counter = 0

                self.end_episode_cnt += 1

        elif self.state == EnvStates.GO_CLOSE:
            if time.time() - self.start_time > 4:
                if round(gripper_target_tf.transform.translation.z, 4) <= -0.02:
                    self.state = EnvStates.CLOSE_GRIPPER

                self.get_logger().info(
                    f'{round(gripper_target_tf.transform.translation.z, 4)}')

        elif self.state == EnvStates.CLOSE_GRIPPER:

            self.skip_saving = True
            if not self.is_object_picked:
                self.state = EnvStates.UP
                self.gripper_status = GripperStatus.CLOSE

                self.start_time = time.time()
                self.is_object_picked = True

                msg = Float64MultiArray()
                msg.data = [-0.01]
                self.publisher_gripper_state.publish(msg)
                self.get_logger().info(
                    f'Close gripper! {round(gripper_target_tf.transform.translation.z, 2)}')

        elif self.state == EnvStates.UP:
            if time.time() - self.start_time > 0.1:
                self.target_pose.pose.position.z = 0.35
                self.state = EnvStates.DOWN
                self.start_time = time.time()

                self.get_logger().info('Move upward...')

        elif self.state == EnvStates.DOWN:
            if time.time() - self.start_time > 3.0:
                self.skip_saving = True
                self.target_pose.pose.position.z = 0.09
                self.state = EnvStates.OPEN_GRIPPER
                self.gripper_status = GripperStatus.OPEN
                self.start_time = time.time()

                self.get_logger().info('Move downward...')

        elif self.state == EnvStates.OPEN_GRIPPER:
            if time.time() - self.start_time > 3.5 and self.is_object_picked:
                self.state = EnvStates.RESET
                self.is_object_picked = False

                self.start_time = time.time()
                self.next_episode_trigger = True

                msg = Float64MultiArray()
                msg.data = [0.0]
                self.publisher_gripper_state.publish(msg)
                self.get_logger().info('Open gripper!')

        elif self.state == EnvStates.RESET:
            if not self.is_trajectory_controler_active:
                call_ros2_service('joint_trajectory_controller',
                                  'cartesian_motion_controller')
                self.is_trajectory_controler_active = True
                self.joint_state.header.stamp = self.get_clock().now().to_msg()
                self.publisher_joint_init.publish(self.joint_state)
                self.get_logger().info(f'Arm inited...')

            if time.time() - self.start_time > 10.0 and self.next_episode_trigger:
                self.state = EnvStates.IDLE
                self.start_time = time.time()
                self.next_episode_trigger = False

                self._publish_random_respawn()
                self.get_logger().info('Move object to the random position!')

                self.new_episode = True

        else:
            self.state = EnvStates.IDLE
            self.start_time = time.time()

        if self.state is not EnvStates.RESET:
            self.publisher_speed_limiter.publish(self.target_pose)

    def _publish_random_respawn(self):
        """Generate a random screwdriver 2D position with wide dispersion
        and publish it through the /respawn Twist topic.

        Twist.linear  -> desired (x, y, z) position
        No rotation is applied.

        Constraints:
        - X range: 0.25 – 0.42 m  (17 cm spread, within Lite6 reach)
        - Y range: -0.08 – 0.18 m (26 cm spread, centered on camera FOV)
        - Z fixed at table height: 0.012 m
        """
        msg = Twist()
        msg.linear.x = random.uniform(0.25, 0.42)
        msg.linear.y = random.uniform(-0.08, 0.18)
        msg.linear.z = 0.012
        self.publisher_respawn.publish(msg)
        self.get_logger().info(
            f'Respawn screwdriver -> pos=({msg.linear.x:.3f}, {msg.linear.y:.3f})')

    def finalize_episode(self):
        """Called upon KeyboardInterrupt to save the current episode data cleanly."""
        if len(self.observations) > 0:
            actions = self.get_action_from_observations(self.observations)
            if hasattr(self, 'action_filename') and self.action_filename:
                self.action_filename.writelines(actions)
                print(f"Saved {len(actions)} actions for the final episode before exit.")
            
        if hasattr(self, 'observation_file') and self.observation_file:
            self.observation_file.close()
            self.observation_file = None
        if hasattr(self, 'action_filename') and self.action_filename:
            self.action_filename.close()
            self.action_filename = None
def main(args=None):
    # Parse data_dir argument from argv
    parser = argparse.ArgumentParser()
    parser.add_argument('--data_dir', type=str, default='DATA', help='Name of data directory.')
    parsed_args, remaining_args = parser.parse_known_args()

    rclpy.init(args=remaining_args)
    test = ControlObjectPicking(data_dir=parsed_args.data_dir)
    try:
        rclpy.spin(test)
    except KeyboardInterrupt:
        print('Ctrl+C detected, saving current episode and shutting down...')
        test.finalize_episode()
    finally:
        test.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()
